node_modules
.vscode
bower_components
html-report
target
.jshintrc
features/step_definitions/result.xls
#yarn.lock
# Generated by tools/apidoc, derived from src/ and never committed. types/ is regenerated on
# prepack so the published package always ships declarations that match its own source.
build
types

# Logs: never committed. test.log and yarn-error.log used to be, and weighed 2.9 MB.
*.log

# Registry credentials belong in the developer's own ~/.npmrc, never in the repository.
.npmrc

# Test coverage, produced by vitest.
coverage

# Editors and OS.
.idea
.DS_Store

# Local development scaffolding, personal to whoever set it up.
.tmuxp.yaml

# Session handoff notes: working documents, never part of the history.
*HANDOFF*.md

# Credentials in plain text. Never in the working tree of a repository, never in its history.
secret.txt
secrets.txt
*.token
.env
.env.*

{
    "name": "opengate-js",
    "version": "15.5.0",
    "description": "JavaScript client for the OpenGate North and South APIs, with a fluent builder API. Runs in Node.js and in the browser.",
    "main": "dist/opengate-api-npm.js",
    "types": "types/opengate-api-npm.d.ts",
    "files": [
        "dist",
        "types",
        "src",
        "opengate-api-npm.js",
        "opengate-api-bower.js",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/amplia-iiot/opengate-js.git"
    },
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=20.19.0"
    },
    "packageManager": "yarn@1.22.22",
    "dependencies": {
        "ajv": "^6.12.0",
        "http-status-codes": "^1.0.6",
        "jsonpath": "1.0.1",
        "jsonschema": "^1.2.0",
        "lodash": "^4.17.21",
        "merge": "^1.2.1",
        "mime-types": "^2.1.35",
        "moment": "^2.14.1",
        "q": "^1.4.1",
        "superagent": "^3.8.3",
        "superagent-mocker": "^0.5.2",
        "urlencode": "^1.1.0",
        "uuid": "9.0.1"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "gulp cucumber",
        "test-wip": "export NODE_OPTIONS='--max-old-space-size=8192'; gulp cucumber --tags @wip",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docs:relearn": "node scripts/generate-relearn-md.js",
        "apidoc": "npm run apidoc:model && npm run apidoc:types",
        "apidoc:model": "node tools/apidoc/extract.mjs --out build/api-model.json",
        "apidoc:types": "tsc -p tools/apidoc/tsconfig.declarations.json",
        "prepack": "npm run apidoc:types"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^4.1.11",
        "babel-core": "^6.26.3",
        "babelify": "^6.1.0",
        "chai": "^3.5.0",
        "chai-as-promised": "^5.3.0",
        "cucumber": "^3.0.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "gulp": "^4.0.2",
        "gulp-babel": "^5.1.0",
        "gulp-browserify": "^0.5.1",
        "gulp-bump": "^2.5.1",
        "gulp-clean": "^0.4.0",
        "gulp-cucumber": "0.0.24",
        "gulp-esdoc": "0.4.1",
        "gulp-ext-replace": "^0.3.0",
        "gulp-flatten": "^0.4.0",
        "gulp-git": "^2.7.0",
        "gulp-rename": "^1.2.2",
        "gulp-sourcemaps": "^1.5.2",
        "gulp-tag-version": "^1.3.0",
        "gulp-terser": "^2.1.0",
        "gulp-ver": "^0.1.0",
        "handlebars": "^4.7.8",
        "jsdoc-to-markdown": "^9.1.3",
        "jsdom": "^16.4.0",
        "minimist": "^1.2.5",
        "mkdirp": "^1.0.4",
        "multiple-cucumber-html-reporter": "^1.18.0",
        "prettier": "^3.6.2",
        "run-sequence": "^2.2.1",
        "should": "^9.0.2",
        "typescript": "^5.9.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "yargs": "^15.4.1"
    },
    "resolutions": {
        "jsonpath/**/underscore": "^1.9.0"
    }
}
